{
  "name": "aleedm.github.io",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "homepage": "https://aleedm.github.io/",
  "scripts": {
    "start": "vite --host 127.0.0.1",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:motion": "node scripts/check-motion.mjs",
    "strava": "node --env-file-if-exists=.env.local scripts/strava.mjs",
    "strava:auth": "node --env-file-if-exists=.env.local scripts/strava-auth.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=22.9"
  }
}
